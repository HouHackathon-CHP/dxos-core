# Local development only. Copy to .env and replace every value before exposing services.
POSTGRES_PASSWORD=replace-with-a-long-random-password
S3_ACCESS_KEY=dxos-local
S3_SECRET_KEY=replace-with-a-long-random-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
INTERNAL_GATEWAY_SECRET=replace-with-a-long-random-secret
DEMO_CITIZEN_PASSWORD=replace-with-a-long-random-password
DEMO_OPERATOR_PASSWORD=replace-with-a-long-random-password
DEMO_OUTSIDER_PASSWORD=replace-with-a-long-random-password

# World Air Quality Index (WAQI) Token - get free token from https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=
