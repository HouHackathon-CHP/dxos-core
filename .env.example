# Local development only. Copy to .env and replace every value before exposing services.
POSTGRES_PASSWORD=replace-with-a-long-random-password
S3_ACCESS_KEY=dxos-local
S3_SECRET_KEY=replace-with-a-long-random-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
INTERNAL_GATEWAY_SECRET=replace-with-a-long-random-secret
DEMO_CITIZEN_USERNAME=dxos-citizen
DEMO_CITIZEN_PASSWORD=replace-with-a-long-random-password
DEMO_OPERATOR_USERNAME=dxos-operator
DEMO_OPERATOR_PASSWORD=replace-with-a-long-random-password
DEMO_OUTSIDER_USERNAME=dxos-outsider
DEMO_OUTSIDER_PASSWORD=replace-with-a-long-random-password
# OpenCity demo accounts. Give each role its own password in the local .env.
# The admin account below is for the OpenCity portal; KEYCLOAK_ADMIN_PASSWORD is for Keycloak master administration.
DEMO_ADMIN_USERNAME=dxos-admin
DEMO_ADMIN_PASSWORD=replace-with-a-long-random-password
DEMO_DISPATCHER_USERNAME=dxos-dispatcher
DEMO_DISPATCHER_PASSWORD=replace-with-a-long-random-password
DEMO_REPORTS_USERNAME=dxos-reports
DEMO_REPORTS_PASSWORD=replace-with-a-long-random-password
DEMO_REPORTS_ENVIRONMENT_USERNAME=dxos-reports-environment
DEMO_REPORTS_ENVIRONMENT_PASSWORD=replace-with-a-long-random-password
DEMO_BULLETINS_USERNAME=dxos-bulletins
DEMO_BULLETINS_PASSWORD=replace-with-a-long-random-password
DEMO_SURVEYS_USERNAME=dxos-surveys
DEMO_SURVEYS_PASSWORD=replace-with-a-long-random-password
DEMO_APPOINTMENTS_USERNAME=dxos-appointments
DEMO_APPOINTMENTS_PASSWORD=replace-with-a-long-random-password
DEMO_ADMINISTRATIVE_FEEDBACK_USERNAME=dxos-administrative-feedback
DEMO_ADMINISTRATIVE_FEEDBACK_PASSWORD=replace-with-a-long-random-password
DEMO_AIR_QUALITY_USERNAME=dxos-air-quality
DEMO_AIR_QUALITY_PASSWORD=replace-with-a-long-random-password
DEMO_BUSINESS_FEEDBACK_USERNAME=dxos-business-feedback
DEMO_BUSINESS_FEEDBACK_PASSWORD=replace-with-a-long-random-password
DEMO_HOTLINES_USERNAME=dxos-hotlines
DEMO_HOTLINES_PASSWORD=replace-with-a-long-random-password
DEMO_COMMUNICATIONS_USERNAME=dxos-communications
DEMO_COMMUNICATIONS_PASSWORD=replace-with-a-long-random-password
DEMO_COMMUNITY_USERNAME=dxos-community
DEMO_COMMUNITY_PASSWORD=replace-with-a-long-random-password
DEMO_SOCIAL_FEEDBACK_USERNAME=dxos-social-feedback
DEMO_SOCIAL_FEEDBACK_PASSWORD=replace-with-a-long-random-password
DEMO_DIGITAL_WARD_USERNAME=dxos-digital-ward
DEMO_DIGITAL_WARD_PASSWORD=replace-with-a-long-random-password
DEMO_BUS_SEARCH_USERNAME=dxos-bus-search
DEMO_BUS_SEARCH_PASSWORD=replace-with-a-long-random-password
# Optional: WAQI provider token for OpenCity air-quality synchronization.
WAQI_API_TOKEN=

